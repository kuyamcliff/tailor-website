{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh", "timeout": 60 }]
      }
    ]
  },
  "permissions": {
    "deny": ["Read(./.env)", "Read(./backend/.env)", "Read(./frontend/.env.local)"]
  }
}
