# Copy to .env (backend) and frontend/.env.local (frontend) and fill in real values.
# Never commit real credentials. Values below are placeholders or safe development defaults.

# ---------------------------------------------------------------------------
# Backend (Go API)
# ---------------------------------------------------------------------------
# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://atelier:atelier@localhost:5432/atelier_dev?sslmode=disable
# run migrations on start (set false if you migrate in a release step)
AUTO_MIGRATE=true
# must be https in production
PUBLIC_SITE_URL=http://localhost:3000
# must be https in production (used for payment callbacks)
PUBLIC_API_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000
# number of reverse proxies in front of the API
TRUSTED_PROXY_HOPS=0
RATE_LIMIT_MULTIPLIER=1
SESSION_TTL_HOURS=720
COOKIE_DOMAIN=
# forced true in production
COOKIE_SECURE=false
# 32+ random characters in production
INTERNAL_API_KEY=
CURRENCY=XAF

# First owner account (used once by: api bootstrap-owner)
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# File storage: local (development) or s3 (any S3-compatible service)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_USE_SSL=true
STORAGE_PUBLIC_BASE_URL=

# Email: disabled | log (development only) | smtp
EMAIL_PROVIDER=log
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMS: disabled | log (development only)
SMS_PROVIDER=log
SMS_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Payments. Leave empty until the merchant accounts are approved; the methods
# stay hidden until their credentials are present and the feature switch is on.
# The simulator is for development only and is refused when APP_ENV=production.
# See docs/payment-integration.md.
# ---------------------------------------------------------------------------
PAYMENTS_DEV_SIMULATOR=true

# production URL given by MTN
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
# mtncameroon in production (value given by MTN)
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# random 32+ characters, used to sign callback URLs
MTN_MOMO_CALLBACK_SECRET=

# base URL given by Orange during onboarding (Core API; paths /omcoreapis/{version}/mp/...)
ORANGE_MONEY_API_URL=
ORANGE_MONEY_API_VERSION=1.0.2
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_AUTH_TOKEN=
ORANGE_MONEY_CHANNEL_MSISDN=
ORANGE_MONEY_PIN=
ORANGE_MONEY_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# Optional reference image suggestions (staff and customers can always describe
# images themselves). Disabled unless a provider and key are set.
# ---------------------------------------------------------------------------
# disabled | anthropic
AI_REFERENCE_PROVIDER=disabled
AI_REFERENCE_API_KEY=
AI_REFERENCE_MODEL=claude-opus-5-5

# Photo-based body measurement estimation (feature switch photo_body_estimation)
BODY_ESTIMATION_PROVIDER=disabled
BODY_ESTIMATION_API_KEY=

# ---------------------------------------------------------------------------
# Frontend (Next.js) - frontend/.env.local
# ---------------------------------------------------------------------------
# how the Next.js server reaches the API
API_INTERNAL_URL=http://localhost:8080
# rewrite target for /api/v1 in the browser
BACKEND_URL=http://localhost:8080
# PUBLIC_SITE_URL is shared with the backend value above
# optional error and performance reporting endpoint
NEXT_PUBLIC_TELEMETRY_URL=
